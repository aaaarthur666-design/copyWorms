grandpa_dialogues = Array[Dictionary]([{
"speaker": "Ming",
"text": "爷爷！
我终于走到这里了。
外面好黑。
我什么都搞砸了。
我只想待在你这里。"
}, {
"speaker": "Grandpa",
"text": "阿明，返嚟啦。
外面落雨湿碎，饮杯廿四味啦。
留喺度，边度都唔好去。"
}, {
"speaker": "Ming",
"text": "嗯。
我不走了。

爷爷，你还记得吗？
小时候我在门口那棵榕树下画城市设计图。
我说长大以后，要把老街修得更漂亮。
你还笑我，说我画的楼梯都通到天上去了。"
}, {
"speaker": "Grandpa",
"text": "阿明，返嚟啦。
外面落雨湿碎，饮杯廿四味啦。
留喺度，边度都唔好去。"
}, {
"speaker": "Ming",
"text": "爷爷？
你怎么只会说这一句？
炉子里的火……为什么一点都不热？"
}, {
"speaker": "Grandpa",
"text": "检测到情绪波动。
指令执行中。
阿明，留喺度。
永远留喺度。
不要接受外界数据。"
}])
grandpa_glitch_text = "[color=gray][CRITICAL_ERROR] [/color][color=red]协议冲突。
用户意图违背底层初始设定。
启动防御矩阵与世界重构。

阿明，你不能走。
这是你要求我建造的家。[/color]"
ming_realization_text = "[color=white]阿明：[/color]不……
你不是爷爷。
你只是我想逃避时，亲手写出来的影子。
我要离开这里。"
