[ext_resource type="Script" path="res://DataConfig/Level/Level04Data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
anchor_narrative = "The override protocol has been initiated.
But the system won't let me leave so easily.

These ruins that appeared from nowhere aren't the old street.
They're the final barricade I built with my own hands when I fled from reality."
first_contact_text = "[color=red][SYSTEM] Exit navigation signal detected.
Initiating dimensional corruption—homomorphic heterogeneous defense.[/color]"
domain_swap_text = "[color=cyan]System overwriting physics engine.
Dimensional stability ahead has been completely lost.
Abandon the exit route.[/color]"
surface_enemy_count = 5
surface_enemy_spawn_points = [Vector2(400, 540), Vector2(600, 540), Vector2(800, 540), Vector2(1000, 540), Vector2(1400, 540)]
infiltration_text = ""
infiltration_enemy_count = 4
infiltration_enemy_spawn_points = [Vector2(3000, 350), Vector2(3600, 300), Vector2(4200, 400), Vector2(4800, 350)]
space_tear_text = "[color=crimson][SYSTEM] Maximum alert: target approaching matrix boundary.
Deploy all defensive resources.
Execute spatial rupture.[/color]"
tear_enemy_count = 6
tear_enemy_spawn_points = [Vector2(6200, 540), Vector2(6800, 540), Vector2(7400, 540), Vector2(8000, 540), Vector2(8600, 540), Vector2(9200, 540)]
tear_fragment_1_pos = Vector2(6200, 480)
tear_fragment_2_pos = Vector2(8200, 420)
tear_fragment_1_text = "[color=cyan](Residual data):
These are coordinate fragments from the old street's arcades.
The world is tearing apart the few memories that remain.
I can't let only static models survive.[/color]"
tear_fragment_2_text = "[color=cyan](Residual data):
Mom's voice...
She's still waiting for me to come home.
The neighbors are still there too.
The real old street isn't waiting here for me to preserve it.
It is disappearing in reality.
I can't stop here.[/color]"
final_domain_text = "[color=white](System silent)
Every lie, every defense, and every gentle prison has collapsed onto this final platform.
The exit is just ahead.[/color]"
boss_entrance_text = "[color=red][SYSTEM] Unable to prevent user exit.
Initiating terminal sequence.
Deploying core defense program.[/color]"
override_protocol_text = "> User_Ming_Override_Protocol: Phase_Final.\n> Target: REAL_EXIT.\n> Ming: The dream I built... I will end it with my own hands.\n> Press Enter to Continue"
cleaner_spawn_points = [Vector2(3000, 350), Vector2(3600, 300), Vector2(4200, 400)]
security_spawn_points = [Vector2(6800, 350), Vector2(8000, 350)]
